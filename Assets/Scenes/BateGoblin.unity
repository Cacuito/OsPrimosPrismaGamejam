    - target: {fileID: 3320098111924348695, guid: d04941624338041d58b8ab5da25a1d35, type: 3}
      propertyPath: falas.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 3320098111924348695, guid: d04941624338041d58b8ab5da25a1d35, type: 3}
      propertyPath: falas.Array.data[0]
      value: Bem-vindo ao esmaga goblin >///<
      objectReference: {fileID: 0}
    - target: {fileID: 3320098111924348695, guid: d04941624338041d58b8ab5da25a1d35, type: 3}
      propertyPath: falas.Array.data[1]
      value: "Use sua arma para amassar a maior quantidade de goblins poss\xEDvel
        UwU"
      objectReference: {fileID: 0}
    - target: {fileID: 3320098111924348695, guid: d04941624338041d58b8ab5da25a1d35, type: 3}
      propertyPath: falas.Array.data[2]
      value: "S\xF3 tome cuidado, nem tudo que voc\xEA v\xEA s\xE3o Goblins OnO"
      objectReference: {fileID: 0}
    - target: {fileID: 3320098111924348695, guid: d04941624338041d58b8ab5da25a1d35, type: 3}
      propertyPath: falas.Array.data[3]
      value: Um bom jogo >///<
      objectReference: {fileID: 0}
    - target: {fileID: 3320098111924348695, guid: d04941624338041d58b8ab5da25a1d35, type: 3}
      propertyPath: falas.Array.data[0].texto
      value: Ola!
      objectReference: {fileID: 0}
    - target: {fileID: 3320098111924348695, guid: d04941624338041d58b8ab5da25a1d35, type: 3}
      propertyPath: falas.Array.data[1].texto
      value: "As regras s\xE3o simples. A cada Goblin que voc\xEA acertar, voc\xEA
        ganha 5 pontos."
      objectReference: {fileID: 0}
    - target: {fileID: 3320098111924348695, guid: d04941624338041d58b8ab5da25a1d35, type: 3}
      propertyPath: falas.Array.data[2].texto
      value: Caso acerte a bomba, o jogo acaba.
      objectReference: {fileID: 0}
    - target: {fileID: 3320098111924348695, guid: d04941624338041d58b8ab5da25a1d35, type: 3}
      propertyPath: falas.Array.data[3].texto
      value: 'Ah! E nao se preocupe com os Goblins, a arma eh de borracha. '
      objectReference: {fileID: 0}
